# ==============================================================================
# TitanPaaS Environment Configuration Example
# Copy this file to .env and adjust values for local development
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://localhost:80
LOG_LEVEL=debug

# Traefik Reverse Proxy
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
BASE_DOMAIN=localhost
DOCKER_NETWORK=titan-network

# Nginx Reverse Proxy (Internal Gateway)
NGINX_PORT=8081

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=titan_paas
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/titan_paas?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# GitHub Webhooks
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_WEBHOOK_PUBLIC_URL=

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user user:email repo
GITHUB_AUTO_LINK_REPOS=true
GITHUB_AUTO_LINK_LIMIT=20

# Encryption Key (AES-256-GCM for secrets and environment variables at rest)
ENCRYPTION_KEY=titan_paas_secret_encryption_key_change_in_production

# Observe Telemetry (Optional)
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET
