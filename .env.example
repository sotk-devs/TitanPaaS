# ==============================================================================
# TitanPaaS Environment Configuration Example
# Copy this file to .env and adjust values for local development
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://localhost:80
LOG_LEVEL=debug

# Nginx Reverse Proxy
NGINX_PORT=80

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=titan_paas
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/titan_paas?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# GitHub Webhooks
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Observe Telemetry (Optional)
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET
